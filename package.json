{
  "name": "avlija",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web app for XiongMai/XM (icsee) IP cameras: live view + PTZ",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/src/server/main.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "probe": "tsx tools/probe.ts",
    "ptz:verify": "tsx tools/ptz-verify.ts",
    "test:e2e": "tsx tools/e2e.ts",
    "test": "npm run typecheck && npm run build && npm run test:e2e",
    "hw:verify": "tsx tools/verify-hardware.ts",
    "verify:audio": "tsx tools/verify-audio-path.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "playwright": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
